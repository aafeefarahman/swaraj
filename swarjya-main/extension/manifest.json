{
  "manifest_version": 3,
  "name": "Translator Proxy",
  "version": "1.0",
  "description": "Translate websites via Google Translate",
  "permissions": ["tabs", "activeTab", "scripting"],
  "host_permissions": [
    "https://translate.google.com/*",
    "https://*.translate.goog/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.translate.goog/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}